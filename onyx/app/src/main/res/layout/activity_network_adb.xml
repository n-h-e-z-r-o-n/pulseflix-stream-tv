<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#042C40"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none"
    tools:context=".NetworkAdbActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvNetworkIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:gravity="center"
                android:text="▣"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:background="#0B465D"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvAdbTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Install to TV"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold"
                android:gravity="center"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvAdbDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Install the app directly to your Android TV over your local network."
                android:textColor="#B8C9D0"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"
                android:gravity="center"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Connection section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#07394D">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect to your TV"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Enter the local IP address shown on your TV."
                android:textColor="#91AEB8"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <!-- IP label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="TV IP address"
                android:textColor="#DCE8EC"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <!-- IP input -->
            <EditText
                android:id="@+id/etIpAddress"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#052F42"
                android:hint="192.168.1.55"
                android:textColor="#FFFFFF"
                android:textColorHint="#6F8993"
                android:textSize="16sp"
                android:singleLine="true"
                android:inputType="textUri"
                android:imeOptions="actionDone"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:importantForAutofill="no" />

            <!-- Connect -->
            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="#E50914"
                android:text="Connect &amp; Install"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="15dp"
            android:background="#063447">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- Requirements -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#063447">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Before you connect"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="• Connect your phone and TV to the same Wi-Fi network."
                android:textColor="#AFC2C9"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="• Enable Developer Options on your TV."
                android:textColor="#AFC2C9"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="• Enable USB debugging option on your TV."
                android:textColor="#AFC2C9"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="If the connection fails, check the TV's IP address and make sure both devices are on the same network."
            android:textColor="#6F8993"
            android:textSize="12sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</ScrollView>

