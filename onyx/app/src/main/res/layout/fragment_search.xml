<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/fragment_search.xml (Mobile Optimized) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/transparentEffect"
    android:orientation="vertical"
    tools:context=".SearchFragment">

    <!-- Top Section (Search Bar, Toggle, Title) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/transparentEffect"
        android:orientation="vertical"
        android:paddingHorizontal="0dp"
        android:paddingTop="16dp"
        tools:ignore="TextSizeCheck">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Search"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/searchCategoryToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="16dp"
            app:checkedButton="@+id/btnAnime"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnime"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Anime"
                android:textColor="?attr/FG_color"
                app:backgroundTint="@color/toggle_background"
                app:strokeColor="@color/card_stroke"
                tools:ignore="HardcodedText,TextContrastCheck" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNormalShows"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Normal Shows"
                android:textColor="?attr/FG_color"
                app:backgroundTint="@color/toggle_background"
                app:strokeColor="@color/card_stroke"
                tools:ignore="HardcodedText" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Search Bar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="8dp"
            android:layout_marginHorizontal="16dp"
            app:strokeColor="?attr/AccentColor"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/searchView"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="@font/p"
                    android:hint="Search for anime..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:singleLine="true"
                    android:textColor="?attr/FG_color"
                    android:textColorHint="#A0A0A0"
                    android:textSize="16sp"
                    tools:ignore="Autofill,HardcodedText,TouchTargetSizeCheck" />

                <ImageButton
                    android:id="@+id/btnVoiceSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:contentDescription="Voice Search"
                    app:tint="@color/image_focus"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hidden TV Keyboard - kept to prevent NullPointerExceptions in SearchFragment.kt -->
        <include
            android:layout_height="0dp"
            android:layout_width="0dp"
            layout="@layout/keyboard_layout"
            android:visibility="gone" />

    </LinearLayout>


    <!-- Bottom Section (Results) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/transparentEffect">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="0dp">

            <LinearLayout
                android:id="@+id/recentSearchesLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Recent Searches"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    android:id="@+id/recentSearchesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/searchTextDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="serif"
                android:text="Search Results"
                android:layout_marginHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <ProgressBar
                android:id="@+id/searchProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="?attr/AccentColor"
                android:visibility="gone" />

            <!-- We MUST keep the recyclerviews as they are accessed by code -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/SearchRecyclerAnime"
                android:layout_width="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                tools:ignore="NestedWeights" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/SearchRecyclerShows"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:layout_gravity="center_horizontal"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                tools:ignore="NestedWeights" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>