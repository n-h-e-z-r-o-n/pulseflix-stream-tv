<!-- res/layout/card_layout.xml (Optimized for Mobile) -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:clickable="true"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/BG_color_up"
    android:foreground="?android:attr/selectableItemBackground"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/cardBackdrop"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:src="@raw/background_3"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <!-- Bottom gradient to make text readable on phone -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/overlay_bottom_gradient_bg"
            android:visibility="visible" />

        <!-- Left gradient (optional, kept small for styling) -->
        <View
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:background="@drawable/overlay_left_gradient_bg_up"
            android:layout_gravity="start" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="bottom"
            android:padding="16dp">

            <TextView
                android:id="@+id/cardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Sakamoto Days Part 2"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/p"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="3"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/cardGenre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Action"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif"
                android:alpha="0.9"
                tools:ignore="HardcodedText"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="4dp"
                    app:cardBackgroundColor="?attr/AccentColor"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/cardQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HD"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="2dp"
                        tools:ignore="HardcodedText,SmallSp" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/cardPg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PG-13"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="2"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/cardType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mv"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/a"
                    tools:ignore="HardcodedText" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_stars"
                    app:tint="?attr/AccentColor"
                    android:layout_marginStart="8dp"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/cardRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9.7"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginStart="4dp"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="2"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/cardYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2025"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginStart="8dp"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="2"
                    tools:ignore="HardcodedText,SmallSp" />
            </LinearLayout>

            <TextView
                android:id="@+id/cardOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="4"
                android:textColor="#EAEAEA"
                android:textSize="8sp"
                android:lineSpacingExtra="2dp"
                tools:ignore="HardcodedText,SmallSp" />

        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>