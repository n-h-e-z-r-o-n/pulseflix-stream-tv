<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/BG_color"
    tools:context=".LiveStreamFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">


        <LinearLayout
            android:id="@+id/sidebarContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:background="?attr/transparentEffect"
            tools:ignore="UselessLeaf">



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/liveFavoritesToggleContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:orientation="horizontal"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:text="My Favorites"
                        android:textStyle="bold"
                        android:textColor="?attr/AccentColor"/>

                    <ImageView
                        android:id="@+id/liveFavoritesToggleIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_stars"
                        app:tint="?attr/AccentColor"
                        tools:ignore="UseAppTint" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/liveFavoritesRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginHorizontal="16dp"
                    android:paddingBottom="10dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:textSize="14sp"
                    android:text="Category"
                    android:textColor="?attr/FG_color"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginHorizontal="16dp"
                    app:cardBackgroundColor="?attr/BG_color_up"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/transparentEffect"
                    app:strokeWidth="1dp">

                    <androidx.appcompat.widget.SearchView
                        android:id="@+id/liveSearchViewCategory"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="4dp"
                        app:iconifiedByDefault="false"
                        app:queryBackground="@android:color/transparent"
                        app:queryHint="Search..." />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
            <!-- Horizontal Categories -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/liveCategoriesRecyclerView"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:orientation="horizontal"
                tools:listitem="@layout/item_category_chip" />

        </LinearLayout>



        <!-- Right Content Area -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top Section: Player & Info -->
            <LinearLayout
                android:id="@+id/topPlayerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Top Left Player -->
                <com.example.onyx.CustomPlayerView
                    android:id="@+id/livePlayerView"
                    android:layout_width="wrap_content"
                    android:layout_height="280dp"
                    android:layout_margin="15dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:resize_mode="fit"
                    app:use_controller="true"
                    app:controller_layout_id="@layout/layout_live_player_controls"
                    app:show_timeout="3000" />

                <!-- Current Channel Info (Right of Player) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginVertical="15dp"
                    android:layout_marginEnd="10dp"
                    app:cardBackgroundColor="?attr/BG_color_up"
                    app:cardCornerRadius="10dp"
                    app:strokeWidth="0dp"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/currentChannelInfo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/currentChannelLogo"
                                android:layout_width="wrap_content"
                                android:adjustViewBounds="true"
                                android:layout_height="60dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_tv"
                                tools:ignore="ContentDescription" />


                            <LinearLayout
                                android:id="@+id/favoriteButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:background="@drawable/watch_button"
                                android:focusableInTouchMode="true"
                                android:focusable="true"
                                android:clickable="true"
                                android:layout_marginEnd="10dp"
                                android:paddingVertical="8dp"
                                android:paddingHorizontal="8dp"
                                android:nextFocusLeft="@+id/TrailerButton"
                                android:nextFocusRight="@+id/serverButton"
                                android:elevation="2dp" >

                                <ImageView
                                    android:id="@+id/favoriteButtonImg"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/ic_addfave"
                                    app:tint="#FFFFFF"
                                    android:focusable="false"
                                    android:focusableInTouchMode="false"
                                    android:clickable="false"
                                    android:background="@android:color/transparent"
                                    android:textAllCaps="false"
                                    android:tooltipText="Add to Favorites"
                                    tools:ignore="UnusedAttribute" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/o"
                            android:letterSpacing="0.1"
                            android:textColor="?attr/AccentColor"
                            android:textSize="14sp"
                            android:textAllCaps="true"
                            tools:text="Category" />

                        <TextView
                            android:id="@+id/currentChannelCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/p"
                            android:textColor="?attr/FG_color"
                            android:textSize="14sp"
                            tools:text="SPORTS" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="10dp"
                                android:background="?attr/BG_color" />


                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/AccentColor"
                                android:letterSpacing="0.1"
                                android:textSize="14sp"
                                android:fontFamily="@font/o"
                                android:text="Up Next"
                                tools:ignore="HardcodedText" />

                            <ScrollView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/upNextDetails"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textColor="?attr/FG_color"
                                        android:textSize="12sp"
                                        android:fontFamily="@font/q"
                                        android:text="No Program Details Available"
                                        android:layout_marginTop="8dp"
                                        tools:ignore="HardcodedText" />

                                </LinearLayout>

                                >

                            </ScrollView>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/BG_color_up" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="200dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="16dp"
                    app:cardBackgroundColor="?attr/BG_color_up"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/transparentEffect"
                    app:strokeWidth="1dp">

                    <androidx.appcompat.widget.SearchView
                        android:id="@+id/liveSearchViewChannel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="4dp"
                        app:iconifiedByDefault="false"
                        app:queryHint="Search..." />

                </com.google.android.material.card.MaterialCardView>


            </LinearLayout>

            <!-- Channels List (Bottom Right) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/liveRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="8dp"
                tools:listitem="@layout/item_live_channel_row" />

        </LinearLayout>
    </LinearLayout>

    <!-- Error Text -->
    <TextView
        android:id="@+id/liveErrorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:textColor="@android:color/holo_red_light"
        android:textSize="16sp"
        android:visibility="gone"
        tools:text="Error loading channels" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/liveProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="visible" />

    <!-- Custom Keyboard -->
    <include
        layout="@layout/keyboard_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="false"
        android:layout_marginBottom="20dp"
        android:visibility="gone" />

</RelativeLayout>
