<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sideBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:visibility="visible"
    android:background="@drawable/overlay_bottom_gradient_bg"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent">







  <HorizontalScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:scrollbars="none">


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
                        android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/sidebarBtnShows"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="5dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="Tv Shows"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusLeft="@id/sidebarBtnShows"
                android:nextFocusUp="@id/sidebarBtnProfile"
                android:nextFocusDown="@id/sidebarBtnAnime"
                android:src="@drawable/ic_anime_home"
                app:tint="@color/nav_icon_color_selector"
                tools:ignore="HardcodedText,DuplicateSpeakableTextCheck,TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/sidebarLabelShows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:visibility="gone"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Shows"
                android:textColor="?attr/FG_color"
                android:textSize="14sp"
                tools:ignore="HardcodedText,InefficientWeight,SmallSp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                        android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/sidebarBtnAnime"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="5dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="Anime"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusLeft="@id/sidebarBtnAnime"
                android:nextFocusUp="@id/sidebarBtnShows"
                android:nextFocusDown="@id/sidebarSearchBtn"
                android:src="@drawable/ic_anime_dubbed"
                app:tint="@color/nav_icon_color_selector"
                tools:ignore="HardcodedText,TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/sidebarLabelAnime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:ellipsize="end"
                android:gravity="center"
                android:visibility="gone"

                android:maxLines="1"
                android:text="Anime"
                android:textColor="?attr/FG_color"
                android:textSize="14sp"
                tools:ignore="HardcodedText,InefficientWeight,SmallSp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/sidebarBtnLive"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="5dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="Anime"
                android:focusable="true"
                android:nextFocusLeft="@id/sidebarBtnLive"
                android:nextFocusUp="@id/sidebarBtnAnime"
                android:nextFocusDown="@id/sidebarSearchBtn"
                android:src="@drawable/ic_live"
                app:tint="@color/nav_icon_color_selector"
                tools:ignore="HardcodedText,TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/sidebarLabelLive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:alpha="0.5"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Live"
                android:textColor="?attr/FG_color"
                android:textSize="14sp"
                tools:ignore="HardcodedText,InefficientWeight,SmallSp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                        android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/sidebarSearchBtn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="5dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="Search"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusLeft="@id/sidebarSearchBtn"
                android:nextFocusUp="@id/sidebarBtnAnime"
                android:nextFocusDown="@id/sidebarWatchListBtn"
                android:src="@drawable/ic_search"
                app:tint="@color/nav_icon_color_selector"
                tools:ignore="HardcodedText,TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/sidebarLabelSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:ellipsize="end"
                android:gravity="center"
                android:visibility="gone"
                android:maxLines="1"
                android:text="Search"
                android:textColor="?attr/FG_color"
                android:textSize="14sp"
                tools:ignore="HardcodedText,InefficientWeight,SmallSp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                        android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/sidebarWatchListBtn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="5dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="Watchlist"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusLeft="@id/sidebarWatchListBtn"
                android:nextFocusUp="@id/sidebarSearchBtn"
                android:nextFocusDown="@id/sidebarFavoritesBtn"
                android:src="@drawable/clock"
                app:tint="@color/nav_icon_color_selector"
                tools:ignore="HardcodedText,TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/sidebarLabelWatchList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:ellipsize="end"
                android:gravity="center"
                android:visibility="gone"
                android:maxLines="1"
                android:text="Watching"
                android:textColor="?attr/FG_color"
                android:textSize="14sp"
                tools:ignore="HardcodedText,InefficientWeight,SmallSp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/sidebarFavoritesBtn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="5dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="Favorites"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusLeft="@id/sidebarFavoritesBtn"
                android:nextFocusUp="@id/sidebarWatchListBtn"
                android:nextFocusDown="@id/sidebarNotificationBtn"
                android:src="@drawable/ic_fave"
                app:tint="@color/nav_icon_color_selector"
                tools:ignore="HardcodedText,TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/sidebarLabelFavorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:ellipsize="end"
                android:gravity="center"
                android:visibility="gone"
                android:maxLines="1"
                android:text="Favorites"
                android:textColor="?attr/FG_color"
                android:textSize="14sp"
                tools:ignore="HardcodedText,InefficientWeight,SmallSp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                        android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cNotificationAnimeIcon"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="top|end"
                    android:visibility="gone"
                    app:cardBackgroundColor="@android:color/holo_red_light"
                    app:cardCornerRadius="50dp"
                    tools:ignore="RtlHardcoded" />

                <ImageButton
                    android:id="@+id/sidebarNotificationBtn"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_margin="5dp"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:contentDescription="Notifications"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusLeft="@id/sidebarNotificationBtn"
                    android:nextFocusUp="@id/sidebarFavoritesBtn"
                    android:nextFocusDown="@id/sidebarBtnProfile"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/nav_icon_color_selector"
                    tools:ignore="HardcodedText,TouchTargetSizeCheck" />
            </FrameLayout>


            <TextView
                android:id="@+id/sidebarLabelNotification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Alerts"
                android:visibility="gone"
                android:textColor="?attr/FG_color"
                android:textSize="14sp"
                tools:ignore="HardcodedText,InefficientWeight,SmallSp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sidebarBtnProfile"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="bottom"
                android:layout_margin="5dp"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/cast_focus"
                android:nextFocusLeft="@id/sidebarBtnProfile"
                android:nextFocusUp="@id/sidebarNotificationBtn"
                android:nextFocusDown="@id/sidebarExitBtn"
                app:cardBackgroundColor="?attr/transparentEffect"
                app:cardCornerRadius="100dp"
                app:cardElevation="0dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/sidebarBtnProfileImg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    tools:ignore="TouchTargetSizeCheck,ImageContrastCheck" />


            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/sidebarLabelProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Profile"
                android:visibility="gone"
                android:textColor="?attr/FG_color"
                android:textSize="14sp"
                tools:ignore="HardcodedText,InefficientWeight,SmallSp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                        android:gravity="center_vertical"
            android:visibility="gone"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/sidebarExitBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="5dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="Watchlist"
                android:focusable="true"
                android:nextFocusLeft="@id/sidebarExitBtn"
                android:nextFocusUp="@id/sidebarBtnProfile"
                android:nextFocusDown="@id/sidebarBtnShows"
                android:src="@drawable/ic_close"
                app:tint="@color/nav_icon_color_selector"
                tools:ignore="HardcodedText,TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/sidebarLabelExit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:visibility="gone"
                android:text="Close App"
                android:textColor="?attr/FG_color"
                android:textSize="13sp"
                tools:ignore="HardcodedText,InefficientWeight,SmallSp" />
        </LinearLayout>
    </LinearLayout>
  </HorizontalScrollView>


</FrameLayout>