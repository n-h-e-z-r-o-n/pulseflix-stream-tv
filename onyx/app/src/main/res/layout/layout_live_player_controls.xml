<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/overlay_bottom_gradient_bg"
    android:clickable="false"
    android:focusable="false"
    android:padding="8dp">

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/exo_play_pause"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:padding="5dp"
            android:adjustViewBounds="true"
            android:background="@drawable/live_button_selector"
            android:src="@drawable/ic_play"
            android:contentDescription="Play/Pause"
            app:tint="@android:color/white"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/btn_live_sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE"
            android:paddingHorizontal="15dp"
            android:paddingVertical="5dp"
            android:textColor="#cc0000"
            android:background="@drawable/live_button_selector"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            tools:ignore="HardcodedText" />


        <TextView
            android:id="@+id/currentChannelName"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-condensed"
            android:textColor="?attr/FG_color"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Select a channel" />


        <ImageButton
            android:id="@+id/btn_live_fave"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:padding="8dp"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:background="@drawable/live_button_selector"
            android:src="@drawable/ic_addfave"
            android:contentDescription="Fullscreen"
            app:tint="@android:color/white"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/btn_fullscreen"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:padding="8dp"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:background="@drawable/live_button_selector"
            android:src="@drawable/ic_fullscreen"
            android:contentDescription="Fullscreen"
            app:tint="@android:color/white"
            tools:ignore="HardcodedText" />
    </LinearLayout>

</RelativeLayout>
