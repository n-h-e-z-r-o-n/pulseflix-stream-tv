<!-- res/layout/anime_card_spotlight.xml (Optimized for Mobile) -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/spotlightAnimesCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:clickable="true"
    android:layout_marginHorizontal="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/BG_color_up"
    android:foreground="?android:attr/selectableItemBackground"
    tools:targetApi="31">

    <FrameLayout
        android:id="@+id/CardBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Image stretches across the full width like a banner -->
        <ImageView
            android:id="@+id/SliderBackdrop"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:scaleType="centerCrop"
            tools:src="@raw/gradient_img"
            tools:ignore="ContentDescription" />

        <!-- Bottom gradient to ensure text readability -->
        <LinearLayout
            android:id="@+id/blurContainerBottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/overlay_bottom_gradient_bg"
            android:orientation="horizontal" />

        <!-- Invisible left container just to satisfy the Kotlin logic without breaking the mobile layout -->
        <LinearLayout
            android:id="@+id/blurContainerLeft"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:orientation="horizontal" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/overlay_bottom_gradient_bg"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/cardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/p"
                android:maxLines="2"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="3"
                tools:text="Sakamoto Days Part 2"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                tools:ignore="HardcodedText" />

            <!-- Row for tags, year, runtime, etc -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Quality Badge -->
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/AccentColor"
                    app:cardCornerRadius="4dp">
                    <TextView
                        android:id="@+id/cardQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HD"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="2dp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                </androidx.cardview.widget.CardView>

                <!-- Sub Badge -->
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/BG_color_up"
                    app:cardCornerRadius="4dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="2dp">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_sub"
                            app:tint="?attr/AccentColor"
                            tools:ignore="ContentDescription" />
                        <TextView
                            android:id="@+id/cardSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:text="2"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Dub Badge -->
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/BG_color_up"
                    app:cardCornerRadius="4dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="2dp">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_dub"
                            app:tint="?attr/AccentColor"
                            tools:ignore="ContentDescription" />
                        <TextView
                            android:id="@+id/cardDub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:text="2"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- PG Rating -->
                <TextView
                    android:id="@+id/cardPg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="PG-13"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <!-- Type -->
                <TextView
                    android:id="@+id/cardType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Mv"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    tools:ignore="HardcodedText" />

                <!-- Rating -->
                <TextView
                    android:id="@+id/cardRuntime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="9.7"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    tools:ignore="HardcodedText" />

                <!-- Year -->
                <TextView
                    android:id="@+id/cardYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="2025"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <!-- Overview -->
            <TextView
                android:id="@+id/cardOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="4"
                android:fontFamily="serif"
                android:textColor="#EAEAEA"
                android:textSize="8sp"
                android:lineSpacingExtra="2dp"
                tools:text="Five years ago, a tear in the fabric of reality brought creatures to our world from an alternate dimension bent on our destruction..."
                tools:ignore="HardcodedText" />

        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
