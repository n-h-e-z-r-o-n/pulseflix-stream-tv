<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/BG_color"
    tools:context=".Login_Page">

    <!-- Background -->
    <ImageView
        android:id="@+id/backgroundImgContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="?attr/themeImage"
        tools:ignore="ContentDescription" />

    <!-- Dark overlay -->
    <View
        android:id="@+id/bottomScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:background="#E9042C40" />

    <!-- Main profile UI -->
    <FrameLayout
        android:id="@+id/profileContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/loginStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="100dp">

                <TextView
                    android:id="@+id/loginBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:background="@drawable/login_settings_pill"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="PULSEFLIX"
                    android:textAllCaps="true"
                    android:textColor="#F5F1EA"
                    android:textSize="11sp"
                    android:fontFamily="@font/p"
                    android:letterSpacing="0.15"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/loginTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/p"
                    android:gravity="center"
                    android:maxLines="2"
                    android:visibility="gone"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="10"
                    android:text="Who's watching?"
                    android:textColor="#FFF8EE"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/loginSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.82"
                    android:visibility="gone"
                    android:fontFamily="@font/n"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="Choose a profile to continue streaming"
                    android:textColor="#FFF3E2"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

                <!-- Profile section -->
                <LinearLayout
                    android:id="@+id/profileStageSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="88dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/profileRailLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.72"
                        android:fontFamily="@font/n"
                        android:letterSpacing="0.08"
                        android:text="PROFILES"
                        android:textAllCaps="true"
                        android:textColor="#FFF4E8"
                        android:textSize="11sp"
                        tools:ignore="HardcodedText" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/profileRecycler"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingStart="4dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="6dp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- Settings panel -->
        <LinearLayout
            android:id="@+id/settingUi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="72dp"
            android:alpha="1"
            android:background="@drawable/login_panel_background"
            android:elevation="12dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:translationY="12dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/settingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/p"
                android:text="Quick Settings"
                android:textColor="#FFF8EE"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/gLocalBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/login_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/p"
                android:nextFocusDown="@+id/gLocalRestore"
                android:nextFocusLeft="@+id/gLocalRestore"
                android:nextFocusRight="@+id/exitSetting"
                android:nextFocusUp="@+id/exitSetting"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:text="Back up Localy"
                android:textColor="#FFF8EE"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/gLocalRestore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/login_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/p"
                android:nextFocusDown="@+id/tvInstall"
                android:nextFocusLeft="@+id/tvInstall"
                android:nextFocusRight="@+id/gLocalBackup"
                android:nextFocusUp="@+id/gLocalBackup"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:text="Restore Local"
                android:textColor="#FFF8EE"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />



            <TextView
                android:id="@+id/tvInstall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/login_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/p"
                android:nextFocusDown="@+id/exitApp"
                android:nextFocusLeft="@+id/exitApp"
                android:nextFocusRight="@+id/gLocalRestore"
                android:nextFocusUp="@+id/gLocalRestore"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:text="Install on your Tv "
                android:textColor="#FFF8EE"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/exitApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/login_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/p"
                android:nextFocusDown="@+id/exitSetting"
                android:nextFocusLeft="@+id/exitSetting"
                android:nextFocusRight="@+id/tvInstall"
                android:nextFocusUp="@+id/tvInstall"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:text="Close app"
                android:textColor="#FFF8EE"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/exitSetting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/login_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/p"
                android:nextFocusDown="@+id/gLocalBackup"
                android:nextFocusLeft="@+id/gLocalBackup"
                android:nextFocusRight="@+id/gLocalRestore"
                android:nextFocusUp="@+id/gLocalRestore"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:text="Done"
                android:textColor="#FFF8EE"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />



        </LinearLayout>

        <!-- Settings button -->
        <TextView
            android:id="@+id/settingButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="60dp"
            android:background="@drawable/login_settings_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingTop="11dp"
            android:paddingEnd="18dp"
            android:paddingBottom="11dp"
            android:text="⚙  Settings"
            android:textColor="#FFF8EE"
            android:textSize="14sp"
            android:fontFamily="@font/p"
            tools:ignore="HardcodedText" />

    </FrameLayout>

    <!-- Create Profile overlay -->
    <FrameLayout
        android:id="@+id/CreateProfileContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#9905070D"
        android:padding="14dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:id="@+id/createProfileCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="4dp"
            app:cardBackgroundColor="#042C40"
            app:cardCornerRadius="24dp"
            app:cardElevation="14dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E60B3446"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/createEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.68"
                        android:fontFamily="@font/n"
                        android:letterSpacing="0.08"
                        android:text="NEW PROFILE"
                        android:textAllCaps="true"
                        android:textColor="#FFF3E6"
                        android:textSize="11sp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/createTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/p"
                        android:layout_marginHorizontal="18dp"
                        android:text="Create a profile"
                        android:textColor="#FFF8EE"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/createSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:alpha="0.7"
                        android:fontFamily="@font/n"
                        android:layout_marginHorizontal="18dp"
                        android:gravity="center"
                        android:text="Pick an avatar, set a name, and keep the experience personal."
                        android:textColor="#FFF1E5"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />

                    <!-- Selected avatar -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/selectedAvatarShell"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginHorizontal="18dp"
                        app:cardBackgroundColor="#22FFFFFF"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/selectedAvatarPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_person"
                            tools:ignore="ContentDescription" />

                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/selectedAvatarLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:alpha="0.72"
                        android:fontFamily="@font/n"
                        android:text="Choose an avatar"
                        android:textColor="#FFF2E5"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />

                    <!-- Username -->
                    <EditText
                        android:id="@+id/usernameInput"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/login_input_field"
                        android:fontFamily="@font/n"
                        android:hint="Profile name"
                        android:imeOptions="actionNext"
                        android:layout_marginHorizontal="18dp"
                        android:maxLines="1"
                        android:nextFocusDown="@+id/usernamePinInput"
                        android:nextFocusLeft="@+id/createProfileBtn"
                        android:nextFocusRight="@+id/createProfileBtn"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:singleLine="true"
                        android:textColor="#FFF8EE"
                        android:textColorHint="#99FFF1E2"
                        android:textSize="15sp"
                        tools:ignore="HardcodedText" />

                    <!-- Hidden gender field preserved for backend -->
                    <EditText
                        android:id="@+id/usernameGenderInput"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <!-- PIN -->
                    <EditText
                        android:id="@+id/usernamePinInput"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/login_input_field"
                        android:fontFamily="@font/n"
                        android:hint="PIN"
                        android:imeOptions="actionDone"
                        android:inputType="numberPassword"
                        android:layout_marginHorizontal="18dp"
                        android:maxLines="1"
                        android:nextFocusDown="@+id/avatarRecycler"
                        android:nextFocusLeft="@+id/usernameInput"
                        android:nextFocusRight="@+id/usernameInput"
                        android:nextFocusUp="@+id/usernameInput"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:singleLine="true"
                        android:textColor="#FFF8EE"
                        android:textColorHint="#99FFF1E2"
                        android:textSize="15sp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/avatarSectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:alpha="0.72"
                        android:layout_marginHorizontal="18dp"
                        android:fontFamily="@font/n"
                        android:text="Avatar selection"
                        android:textColor="#FFF1E5"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/avatarRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="92dp"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:nextFocusDown="@+id/createProfileBtn"
                        android:overScrollMode="never"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />

                    <!-- Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/createProfileBtn"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/login_primary_button"
                            android:clickable="true"
                            android:enabled="false"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:layout_marginHorizontal="18dp"
                            android:fontFamily="@font/p"
                            android:gravity="center"
                            android:nextFocusDown="@+id/cancelProfileBtn"
                            android:nextFocusLeft="@+id/cancelProfileBtn"
                            android:nextFocusRight="@+id/cancelProfileBtn"
                            android:nextFocusUp="@+id/avatarRecycler"
                            android:text="Create profile"
                            android:textColor="#FFF8EE"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/cancelProfileBtn"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/login_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:fontFamily="@font/p"
                            android:gravity="center"
                            android:layout_marginHorizontal="18dp"
                            android:nextFocusDown="@+id/usernameInput"
                            android:nextFocusLeft="@+id/createProfileBtn"
                            android:nextFocusRight="@+id/createProfileBtn"
                            android:nextFocusUp="@+id/avatarRecycler"
                            android:text="Cancel"
                            android:textColor="#FFF8EE"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

        </androidx.cardview.widget.CardView>

    </FrameLayout>

</FrameLayout>

